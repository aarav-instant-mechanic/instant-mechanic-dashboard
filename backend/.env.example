# Copy this file to backend/.env and fill it in. Never push .env to GitHub.

# Leave empty to use a local file database on your PC (good for trying things out).
# For the shared online database, paste the Neon connection string here.
DATABASE_URL=

# A long random text. Make one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# The two logins. They are created the first time the backend starts.
# To change a password later, use Manage > Logins in the dashboard.
ADMIN_EMAIL=
ADMIN_PASSWORD=
AGENT_EMAIL=
AGENT_PASSWORD=

# The address of the frontend. Locally this is http://localhost:3000
# On Render, set it to your static site address, e.g. https://instant-mechanic-dashboard.onrender.com
FRONTEND_URL=http://localhost:3000

# Optional. Where "Manage > Sync from site" reads the mechanic list. Leave out to use the company site.
# MECHANIC_SOURCE_URL=https://ai.instantmechanic.online/bot/api/mechanic-location-list
# MECHANIC_SOURCE_TOKEN=
# LIVE_SYNC=off
